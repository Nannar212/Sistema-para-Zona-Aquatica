# ============================================
# Frontend en producción: compila React y lo sirve con Caddy
# ============================================

# 1) Compilar la app de React (Vite)
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# 2) Servir los archivos estáticos con Caddy (incluye HTTPS automático)
FROM caddy:2-alpine
COPY --from=build /app/dist /srv
# El Caddyfile se monta desde docker-compose.prod.yml
