# Copia este archivo como .env en el servidor y pon valores REALES y seguros.
# NO subas el .env a internet ni a GitHub.

# Tu dominio (ya apuntando al servidor)
DOMAIN=zonaaquatica.com

# Base de datos (usa una contraseña larga y aleatoria)
POSTGRES_DB=piscina_db
POSTGRES_USER=piscina_admin
POSTGRES_PASSWORD=pon_una_contrasena_larga_y_aleatoria

# Claves secretas (genera cadenas aleatorias distintas para cada una)
SECRET_KEY=cambia_esto_por_algo_aleatorio_largo
JWT_SECRET_KEY=cambia_esto_por_otro_valor_aleatorio_largo

# Admin inicial (cámbialo al primer ingreso)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=UnaClaveFuerte123!
